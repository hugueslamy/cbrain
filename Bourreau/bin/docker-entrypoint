#!/bin/bash -e

# Runs as root, then hands over to sshd.

home=/home/cbrain

# Gemfile.lock is not in git: a fresh clone has none. Resolving the bundle
# again could pick newer gem versions or git revisions than the image has,
# so a checkout without a lock gets the image's. Then install what is still
# missing (e.g. after a Gemfile change), as 'cbrain' (owner of the bundle),
# before the portal starts Rails over SSH.
cd /cbrain/Bourreau
[ -f Gemfile.lock ] ||
  runuser -u cbrain -- cp -n /usr/local/share/cbrain/Gemfile.lock Gemfile.lock 2>/dev/null || true
runuser -u cbrain -- bundle check >/dev/null 2>&1 ||
  runuser -u cbrain -- bundle install --quiet

# Generate the SSH host keys once; they are kept in a volume so the
# portal's known_hosts stays valid when this container is rebuilt
hostkeys=/etc/ssh/hostkeys
mkdir -p "$hostkeys"
for type in ed25519 ecdsa rsa; do
  [ -f "$hostkeys/ssh_host_${type}_key" ] ||
    ssh-keygen -q -t "$type" -N '' -C "root@bourreau" -f "$hostkeys/ssh_host_${type}_key"
done

# Authorize the portal's CBRAIN key for user 'cbrain'
if [ -f /run/cbrain/portal_key.pub ]; then
  install -o cbrain -g cbrain -m 600 /run/cbrain/portal_key.pub "$home/.ssh/authorized_keys"
else
  echo "Warning: /run/cbrain/portal_key.pub is missing; the portal will not be able to connect." >&2
fi

# SSH sessions don't inherit the Docker environment: save what the
# Bourreau needs; ~/.bashrc sources this file.
{
  for var in PATH GEM_HOME BUNDLE_APP_CONFIG BUNDLE_JOBS RAILS_ENV CBRAIN_RAILS_APP_NAME LANG; do
    [ -n "${!var}" ] && printf 'export %s=%q\n' "$var" "${!var}"
  done
} > "$home/.cbrain_docker_env"
chown cbrain:cbrain "$home/.cbrain_docker_env"

# The portal sends config/database.yml at each start and cbrain_remote_ctl
# deletes it when the Bourreau stops. A copy left at container boot is from
# a start cut off by a restart: remove it, or the next start would use it
# instead of the one the portal sends.
rm -f /cbrain/Bourreau/config/database.yml

# Cache and task work directories, and the files of the 'bourreau_data'
# Data Provider (paths set in the records by the portal's db/seeds_docker.rb).
# One directory per Bourreau name: the UNIX and Slurm setups share this
# volume, and CBRAIN refuses a cache directory used by another server.
bdir="$home/data/${CBRAIN_RAILS_APP_NAME:?must be set}"
mkdir -p "$bdir/cache" "$bdir/work" "$home/data/dp"
chown cbrain:cbrain "$home/data" "$bdir" "$bdir/cache" "$bdir/work" "$home/data/dp"
chmod 700 "$bdir/cache"

# Munge authenticates this login node to the emulated Slurm cluster
# (docker/slurm). All Slurm containers share one key, in the munge_key
# volume; the first container to boot creates it (mv -n: no overwrite).
shared_key=/etc/munge-shared/munge.key
if [ -d /etc/munge-shared ]; then
  if [ ! -s "$shared_key" ]; then
    dd if=/dev/urandom bs=1 count=1024 status=none > "$shared_key.$$"
    mv -n "$shared_key.$$" "$shared_key"
    rm -f "$shared_key.$$"
  fi
  install -o munge -g munge -m 400 "$shared_key" /etc/munge/munge.key
  install -d -o munge -g munge -m 755 /run/munge
  runuser -u munge -- /usr/sbin/munged
fi

exec "$@"

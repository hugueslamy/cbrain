#!/bin/bash -e

# Gemfile.lock is not in git: a fresh clone has none. Resolving the bundle
# again here could pick newer gem versions or git revisions than the image
# has (aws-partitions is released almost daily), which the 'test' container,
# without network access, could not install. So a checkout without a lock
# gets the image's (cp -n: 'web' and 'test' may start together).
# Then install what is still missing, e.g. after a Gemfile change (needs
# network access; the bundle belongs to 'cbrain' for this reason).
[ -f Gemfile.lock ] || cp -n /usr/local/share/cbrain/Gemfile.lock Gemfile.lock 2>/dev/null || true
bundle check >/dev/null 2>&1 || bundle install --quiet

# SSH agents never survive a container restart: remove leftover sockets
# whose agent is gone, otherwise z000_ensure_we_have_a_local_ssh_agent
# refuses to create a new agent over them. A live agent (e.g. the server's,
# when this is a 'docker compose run' console) is left alone.
# ssh-add exits with 2 when it cannot reach the agent.
for sock in tmp/sockets/ssh-agent.*.sock; do
  [ -e "$sock" ] || continue
  rc=0; SSH_AUTH_SOCK="$sock" ssh-add -l >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 2 ]; then
    name="${sock#tmp/sockets/ssh-agent.}"; name="${name%.sock}"
    rm -f "$sock" tmp/"$name"@*.agent.bashrc
  fi
done

# Before the Rails server starts (not for consoles or one-off commands),
# bring the database and plugins up to date. All steps are idempotent:
#   db:prepare             new database: load the schema and run db/seeds.rb
#                          (admin user, with a random password printed in the
#                          logs, and the portal record); existing one: migrate
#   db:sanity:check        the portal refuses to boot until it has been run
#   cbrain:plugins:install symlinks of the plugins in cbrain_plugins/ (shared
#                          with the Bourreau, whose cbrain_plugins is a symlink)
#   db:seed:docker         Bourreau and Data Provider of this Docker setup
#                          (db/seeds_docker.rb); creates missing records only
# One rake run: CBRAIN skips its boot checks for db: and cbrain:plugins tasks.
if [ "$1" == "./bin/rails" ] && [ "$2" == "server" ]; then
  bundle exec rake db:prepare db:sanity:check cbrain:plugins:install:all db:seed:docker
fi

exec "${@}"

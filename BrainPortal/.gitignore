# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle
/vendor/bundle

# Ignore all environment files & secrets.
/.env*
/config/*.key
/config/credentials/*.key
/docker-compose.override.yml

# Ignore all logfiles
/log/*
!/log/.keep

# Ignore Temp files
/tmp/*
!/tmp/.keep
!/tmp/pids/.keep
!/tmp/storage/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep

# Ignore generated schema dump — keep only schema.rb
/db/schema.rb.lock

# Assets build output
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# This will be removed/adjusted in a future CBRAIN release
/seeds_dev_support_dir

# Node (if ever added)
/node_modules
/.yarn

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
*.swo

# Test coverage
/coverage

# Kamal deploy lock
/.kamal/lock
